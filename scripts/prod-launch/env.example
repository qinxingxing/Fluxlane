# Copy to .env on the jump host. Do not commit real secrets.
# chmod 600 .env

# Public hostnames used for TLS SNI.
API_HOST=api.fluxlane.ai
RUN_HOST=run.fluxlane.ai

# Override to hit one node (private IP) while keeping SNI.
# Example: API-1 private IP
# API_RESOLVE=10.20.1.14
# RUN_RESOLVE=10.20.1.15

API_BASE=https://api.fluxlane.ai
RUN_BASE=https://run.fluxlane.ai

# Dedicated load-test token (sk-...). Never a customer key.
TEST_API_KEY=

# Optional dashboard access token for /api/user/self and /api/log/self.
DASHBOARD_ACCESS_TOKEN=

# Cheap or mock model reserved for launch tests.
TEST_MODEL=gpt-4o-mini

# Seconds to wait after a request so BATCH_UPDATE can flush (default interval is 5s).
SETTLE_WAIT_SECONDS=8

# Frontend origin used in CORS checks.
FRONTEND_ORIGIN=https://www.fluxlane.ai

# Nodes for smoke.sh (kind|tls-hostname|ip). These are cutover-target CVMs.
# Run smoke.sh from the jump host; public 443 on these IPs may not be open elsewhere.
# Live DNS may still point at older IPs until cutover.
API_NODES="api|api.fluxlane.ai|124.156.104.48 api|api.fluxlane.ai|43.154.68.173"
RUN_NODES="run|run.fluxlane.ai|43.154.184.164 run|run.fluxlane.ai|150.109.45.79"
